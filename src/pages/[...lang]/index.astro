---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { copy, localePaths, type Locale } from '../../lib/copy';
import { SITE, PATHS } from '../../lib/site.mjs';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
---
<Base lang={lang} path={PATHS.home} title={t.meta.home.title} description={t.meta.home.description} hero>
  <section class="hero">
    <div class="wrap">
      <Logo class="hero-logo" />
      <div class="hero-body">
        <h1>{t.home.headline}</h1>
        <StoreButtons lang={lang} />
      </div>
    </div>
  </section>
  <section class="intro">
    <div class="wrap">
      <p class="contact">{t.home.contact} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>
</Base>
