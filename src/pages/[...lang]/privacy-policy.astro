---
import Legal from '../../layouts/Legal.astro';
import { Content as En } from '../../legal/privacy-policy.md';
import { Content as Tr } from '../../legal/privacy-policy.tr.md';
import { copy, localePaths, type Locale } from '../../lib/copy';
import { PATHS } from '../../lib/site.mjs';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang].meta.privacy;
const Doc = lang === 'tr' ? Tr : En;
---
<Legal lang={lang} path={PATHS.privacy} title={t.title} description={t.description}>
  <Doc />
</Legal>
